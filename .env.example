# Copy to .env (which is git-ignored) to enable the optional AI mode.
# Leave ANTHROPIC_API_KEY empty to run in demo mode only.
# The key is read by the Node server only and is never sent to the browser.
ANTHROPIC_API_KEY=

# Optional: model used for AI mode. Check this against your account's available models.
DOCULENS_MODEL=claude-sonnet-5-5

# Optional server settings (defaults shown)
PORT=8787
HOST=127.0.0.1
# Comma-separated Host headers the API will accept (DNS-rebinding guard).
# DOCULENS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
